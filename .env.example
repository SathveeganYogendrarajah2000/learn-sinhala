# ===========================================
# Learn Sinhala - Environment Variables
# Copy this file to .env and update values
# ===========================================

# MongoDB Root Credentials (for initial setup)
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=change-this-admin-password

# MongoDB Application Credentials
MONGO_USER=learnsinhala
MONGO_PASSWORD=change-this-app-password

# MongoDB Port (optional, default: 27017)
MONGO_PORT=27017

# JWT Configuration
# Generate with: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-that-should-be-at-least-256-bits-long-change-this
JWT_EXPIRATION=86400000

# Spring Profile
# Options: dev, docker, prod
SPRING_PROFILE=docker

# Port Configuration
BACKEND_PORT=8080
FRONTEND_PORT=80
