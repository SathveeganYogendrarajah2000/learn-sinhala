# ===========================================
# Learn Sinhala - Environment Variables
# ===========================================

# Copy to .env and update with your values
# NEVER commit .env file to git!

# ===========================================
# MongoDB Credentials
# ===========================================

# Root admin user (for database administration)
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_123

# Application database user
MONGO_USER=learnsinhala
MONGO_PASSWORD=CHANGE_THIS_APP_PASSWORD_456

# MongoDB port (default: 27017)
MONGO_PORT=27017

# ===========================================
# JWT Security  
# ===========================================

# Generate with: openssl rand -base64 64
# Must be at least 256 bits (64 base64 chars)
JWT_SECRET=CHANGE_THIS_TO_RANDOM_STRING_GENERATED_WITH_OPENSSL_RAND_BASE64_64

# Token expiration in milliseconds (86400000 = 24 hours)
JWT_EXPIRATION=86400000

# ===========================================
# Application Ports
# ===========================================

# Backend API port
BACKEND_PORT=8080

# Frontend web port
FRONTEND_PORT=80

# ===========================================
# Spring Profile
# ===========================================

# Options: docker (local), prod (production)
SPRING_PROFILE=docker
