# ===========================================
# Learn Sinhala - Local Development Variables
# ===========================================
# Copy to .env and update with your values
# NEVER commit .env file to git!

# ===========================================
# MongoDB (local)
# ===========================================
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/learnsinhala_dev

# ===========================================
# JWT Security
# ===========================================
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_THIS_TO_RANDOM_STRING_GENERATED_WITH_OPENSSL_RAND_BASE64_64
JWT_EXPIRATION=86400000
