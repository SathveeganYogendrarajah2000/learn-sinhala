# ===========================================
# Learn Sinhala - Cloud Run Environment Variables
# ===========================================
# These variables are set in Google Cloud Run console
# under each service's "Edit & Deploy" > "Variables & Secrets"

# ===========================================
# Backend Service Environment Variables
# ===========================================

# MongoDB Atlas connection string
SPRING_DATA_MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@your-cluster.mongodb.net/learnsinhala-prod?retryWrites=true&w=majority&authSource=admin

# Spring profile
SPRING_PROFILES_ACTIVE=prod

# JWT Security (generate with: openssl rand -base64 64)
JWT_SECRET=GENERATE_NEW_SECRET_WITH_OPENSSL_RAND_BASE64_64_COMMAND
JWT_EXPIRATION=86400000

# CORS - set to your frontend Cloud Run URL
CORS_ALLOWED_ORIGINS=https://your-frontend-service-xxxxx.run.app

# ===========================================
# Frontend Service Environment Variables
# ===========================================
# (No env vars needed — the backend URL is baked into
#  the Angular build via environment.prod.ts)
