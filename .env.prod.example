# ===========================================
# Production Environment Variables
# ===========================================
# Copy this file to .env.prod on your production server

# ===========================================
# MongoDB Atlas (Cloud Database)
# ===========================================

# Get your connection string from MongoDB Atlas dashboard
# Format: mongodb+srv://<username>:<password>@cluster.xxxxx.mongodb.net/learnsinhala?retryWrites=true&w=majority&authSource=admin
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@your-cluster.mongodb.net/learnsinhala-prod?retryWrites=true&w=majority&authSource=admin

# ===========================================
# JWT Security (CHANGE THESE!)
# ===========================================

# Generate with: openssl rand -base64 64
# MUST be different from local!
JWT_SECRET=GENERATE_NEW_SECRET_WITH_OPENSSL_RAND_BASE64_64_COMMAND
JWT_EXPIRATION=86400000

# CORS Configuration
# ⚠️ WARNING: Allowing all origins (*) is INSECURE for production!
# Use only for development/testing. For production, specify exact domains.
# For local development: http://localhost,http://localhost:4200,http://localhost:80
# For production: https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOWED_ORIGINS=*

# Backend URL for Frontend (used in nginx proxy)
# For local docker-compose: http://backend:8080
# For separate deployment: https://api.yourdomain.com
BACKEND_URL=https://learn-sinhala-backend-809391430909.asia-south1.run.app

# ===========================================
# Spring Profile
# ===========================================
SPRING_PROFILE=prod

# ===========================================
# Application Ports
# ===========================================
BACKEND_PORT=8080
FRONTEND_PORT=80
